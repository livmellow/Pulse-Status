# Railway PostgreSQL (automatically set as ${{ Postgres.DATABASE_URL }} in Railway)
DATABASE_URL=
APP_URL=https://pulsestatus.livmellow.com
AUTH_SECRET=

# Google OAuth (create at Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification and password reset (recommended: Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@pulsestatus.livmellow.com

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
